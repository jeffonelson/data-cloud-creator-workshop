#!/usr/bin/env bash
# Populate one existing, billed project. Does not configure local agents.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if ! command -v python3 >/dev/null 2>&1; then
  echo 'Missing python3. Install Python 3, then retry.' >&2
  exit 1
fi
exec python3 "$repo_root/scripts/provision.py" "$@"
