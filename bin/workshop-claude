#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/workshop-common.sh
source "$repo_root/bin/lib/workshop-common.sh"
workshop_load_config

if ! command -v claude >/dev/null 2>&1; then
  workshop_error "Missing required command: claude"
  exit 1
fi

workshop_prepare_launch claude
workshop_info "Launching Claude Code for project: $WORKSHOP_PROJECT_ID"

# Claude Code has no equivalent of Codex's shell_environment_policy filters, so
# WORKSHOP_DK_API_KEY and WORKSHOP_MAPS_API_KEY remain visible to shell commands
# the agent runs. Workshop exercises must not dump the environment.
cd "$repo_root"
exec claude "$@"
