#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/workshop-common.sh
source "$repo_root/bin/lib/workshop-common.sh"
workshop_load_config

state_dir="$(workshop_state_dir)"
mkdir -p "$state_dir"
project_state="$(workshop_project_state_file)"

usage() {
  echo "Usage: $0 [PROJECT_ID] [--region REGION]"
  echo "Installs one Data Agent Kit release and configures BigQuery and AlloyDB."
  echo "Supply --region for a new project; retries reuse its saved region."
}

GCP_PROJECT_ID=''
requested_region=''
while (( $# )); do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --region)
      (( $# >= 2 )) || { usage >&2; exit 2; }
      requested_region="$2"
      workshop_region_is_valid "$requested_region" || { workshop_error "Invalid --region value."; exit 2; }
      shift
      ;;
    -*) usage >&2; exit 2 ;;
    *)
      [[ -z "$GCP_PROJECT_ID" ]] || { echo "Supply only one project ID." >&2; exit 2; }
      GCP_PROJECT_ID="$1"
      ;;
  esac
  shift
done
[[ -n "$GCP_PROJECT_ID" ]] || GCP_PROJECT_ID="$(workshop_saved_project)"

if [[ -z "$GCP_PROJECT_ID" ]]; then
  usage >&2
  echo "Use the dedicated Google Cloud project assigned to you." >&2
  exit 2
fi

if ! workshop_project_id_is_valid "$GCP_PROJECT_ID"; then
  workshop_error "Invalid Google Cloud project ID: $GCP_PROJECT_ID"
  exit 2
fi

if [[ -z "$requested_region" ]]; then
  if [[ "$GCP_PROJECT_ID" == "$(workshop_saved_project)" ]]; then
    workshop_load_project_region || exit 1
    requested_region="$DAK_GCP_REGION"
  else
    workshop_error "Supply the lab region: ./bin/setup PROJECT_ID --region REGION"
    exit 2
  fi
fi
DAK_GCP_REGION="$requested_region"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    workshop_error "Missing required command: $1"
    exit 1
  fi
}

require_command gcloud
require_command git
require_command node
require_command npm
if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 22 || (major === 22 && minor >= 6) ? 0 : 1)'; then
  workshop_error "Data Agent Kit setup requires Node.js 22.6 or newer. Install the current Node.js LTS release."
  exit 1
fi

# Configure whichever supported coding agents are installed. At least one is
# required; every installed supported agent is configured.
has_codex=false
has_claude=false
has_antigravity=false
if workshop_has_antigravity; then has_antigravity=true; fi
if command -v codex >/dev/null 2>&1; then
  has_codex=true
fi
if command -v claude >/dev/null 2>&1; then
  has_claude=true
fi

if [[ "$has_codex" == false && "$has_claude" == false && "$has_antigravity" == false ]]; then
  workshop_error "No supported coding agent found. Install Codex, Claude Code, or Antigravity (desktop or CLI)."
  exit 1
fi

workshop_info "Checking Google Cloud CLI authentication..."
active_account="$(gcloud auth list --project="$GCP_PROJECT_ID" --filter=status:ACTIVE --format='value(account)' 2>/dev/null | head -n 1)"
if [[ -z "$active_account" ]]; then
  workshop_error "No active gcloud account. Run: gcloud auth login"
  exit 1
fi

if ! gcloud auth application-default print-access-token --project="$GCP_PROJECT_ID" >/dev/null 2>&1; then
  workshop_error "Application Default Credentials are unavailable."
  workshop_hint "Run: gcloud auth application-default login"
  exit 1
fi

if ! gcloud projects describe "$GCP_PROJECT_ID" --project="$GCP_PROJECT_ID" >/dev/null 2>&1; then
  workshop_error "The active account cannot access project: $GCP_PROJECT_ID"
  workshop_hint "Check project IAM and the active gcloud account."
  exit 1
fi

for secret_id in "$DK_SECRET_ID" "$MAPS_SECRET_ID"; do
  if ! gcloud secrets versions access "$SECRET_VERSION" \
    --secret="$secret_id" \
    --project="$GCP_PROJECT_ID" \
    >/dev/null 2>&1; then
    workshop_error "Cannot access Secret Manager secret: $secret_id"
    workshop_hint "Ask a workshop administrator to provision your assigned project."
    exit 1
  fi
done

CLOUD_RUN_REGION="${CLOUD_RUN_REGION:-$DAK_GCP_REGION}"
workshop_region_is_valid "$CLOUD_RUN_REGION" || { workshop_error "Invalid CLOUD_RUN_REGION in config/workshop.env."; exit 1; }
workshop_ok "AlloyDB region: $DAK_GCP_REGION; Cloud Run region: $CLOUD_RUN_REGION. BigQuery uses its dataset location."

umask 077
# Reject a conflicting shared upstream configuration before changing any agent.
workshop_dak_settings preflight "$GCP_PROJECT_ID"

# Data Agent Kit version. DAK_REF overrides; otherwise reuse the release this
# checkout already recorded, and only on a fresh checkout (or after teardown)
# resolve the newest upstream release. Every agent below installs this one ref.
if [[ -n "${DAK_REF:-}" ]] && ! workshop_dak_ref_is_valid "$DAK_REF"; then
  workshop_error "DAK_REF must be an immutable release tag or full commit SHA."
  exit 1
fi
if ! DAK_EFFECTIVE_REF="$(workshop_effective_dak_ref)"; then
  workshop_info "Resolving the latest Data Agent Kit release..."
  if ! DAK_EFFECTIVE_REF="$(workshop_latest_dak_release)"; then
    workshop_error "Cannot determine the latest Data Agent Kit release from $DAK_REPOSITORY"
    workshop_hint "Check network access, or pin DAK_REF in config/workshop.env."
    exit 1
  fi
fi
printf '%s\n' "$DAK_EFFECTIVE_REF" >"$(workshop_dak_ref_state_file)"
if [[ -n "${DAK_REF:-}" ]]; then
  workshop_ok "Data Agent Kit version pinned by config/workshop.env: $DAK_EFFECTIVE_REF"
else
  workshop_ok "Data Agent Kit release: $DAK_EFFECTIVE_REF"
fi

# Inspect every supported CLI before changing either installation. Leave old
# Starter Pack installs and mismatched GA installs for the attendee to resolve.
for agent in codex claude; do
  command -v "$agent" >/dev/null 2>&1 || continue
  legacy_plugin="$(workshop_agent_entry "$agent" plugin dak@data-agent-kit-starter-pack-marketplace)"
  if [[ "$legacy_plugin" != null ]]; then
    workshop_error "$agent: the previous DAK Starter Pack is installed. Preserve it or remove it with that agent's plugin commands before migrating; setup will not replace it."
    exit 1
  fi
  marketplace_entry="$(workshop_agent_entry "$agent" marketplace)"
  plugin_entry="$(workshop_agent_entry "$agent" plugin)"
  if [[ "$marketplace_entry" != null || "$plugin_entry" != null ]]; then
    if ! report="$(workshop_check_dak_installation "$agent" "$DAK_EFFECTIVE_REF" existing)"; then
      printf '%s\n' "$report"
      workshop_error "Resolve the existing $agent DAK installation with its plugin commands, then retry. Setup does not upgrade pre-existing installations."
      exit 1
    fi
  fi
done

printf 'GCP_PROJECT_ID=%s\nALLOYDB_REGION=%s\nCLOUD_RUN_REGION=%s\n' "$GCP_PROJECT_ID" "$DAK_GCP_REGION" "$CLOUD_RUN_REGION" >"$project_state"
workshop_ok "Workshop project $GCP_PROJECT_ID and Secret Manager access are ready."

setup_agent_dak() {
  local agent="$1" marketplace_entry plugin_entry
  local marketplace_marker=marketplace-added-by-workshop plugin_marker=plugin-added-by-workshop
  [[ "$agent" != claude ]] || { marketplace_marker=claude-marketplace-added-by-workshop; plugin_marker=claude-plugin-added-by-workshop; }
  marketplace_entry="$(workshop_agent_entry "$agent" marketplace)"
  plugin_entry="$(workshop_agent_entry "$agent" plugin)"
  if [[ "$marketplace_entry" == null ]]; then
    if [[ "$agent" == codex ]]; then
      codex plugin marketplace add "$DAK_REPOSITORY" --ref "$DAK_EFFECTIVE_REF"
    else
      claude plugin marketplace add "$DAK_REPOSITORY.git#$DAK_EFFECTIVE_REF"
    fi
    touch "$state_dir/$marketplace_marker"
  fi
  if [[ "$plugin_entry" == null ]]; then
    if [[ "$agent" == codex ]]; then
      codex plugin add "$DAK_PLUGIN"
    else
      claude plugin install "$DAK_PLUGIN" --yes
    fi
    touch "$state_dir/$plugin_marker"
  fi
  if ! workshop_check_dak_installation "$agent" "$DAK_EFFECTIVE_REF"; then
    workshop_error "$agent: DAK did not reach the requested release; inspect its plugin installation and retry."
    return 1
  fi
  workshop_configure_dak "$agent" "$(workshop_dak_plugin_root "$agent")" "$GCP_PROJECT_ID"
}

if [[ "$has_codex" == true ]]; then
  echo
  workshop_info "Configuring Codex..."

  setup_agent_dak codex
fi

if [[ "$has_claude" == true ]]; then
  echo
  workshop_info "Configuring Claude Code..."

  setup_agent_dak claude
fi

echo
if [[ "$has_antigravity" == true ]]; then
  workshop_info "Configuring Antigravity desktop and CLI..."
  workshop_setup_antigravity
fi
workshop_print_line "$WORKSHOP_SGR_GREEN$WORKSHOP_SGR_BOLD" 1 "Setup complete for project: $GCP_PROJECT_ID"
echo "Restart any open agent session to load the configured Data Agent Kit services."
if [[ "$has_codex" == true ]]; then
  echo "Launch Codex with:        ./bin/workshop-codex"
fi
if [[ "$has_claude" == true ]]; then
  echo "Launch Claude Code with:  ./bin/workshop-claude"
fi
echo "On first launch, trust this repository so the project-scoped MCP configuration loads."
if [[ "$has_antigravity" == true ]]; then
  echo "Launch Antigravity CLI:   ./bin/workshop-antigravity"
  echo "Or open this folder in Antigravity desktop and refresh MCP servers."
fi
