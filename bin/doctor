#!/usr/bin/env bash
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
usage() {
  echo "Usage: $0 [--preflight]"
  echo "--preflight checks local prerequisites only; no sign-in or project is required."
}

preflight=false
if (( $# > 1 )); then usage >&2; exit 2; fi
case "${1:-}" in
  '') ;;
  --preflight) preflight=true ;;
  --help|-h) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

# shellcheck source=lib/workshop-common.sh
source "$repo_root/bin/lib/workshop-common.sh"
if [[ "$preflight" == false ]]; then
  workshop_load_config
  GCP_PROJECT_ID="$(workshop_saved_project)"
  workshop_source_env_local
fi

failures=0
warnings=0

# A check report, not a procedure, so these use their own labels rather than
# the shared workshop_info/ok/warn/error family. All three stay on stdout: the
# report is one ordered stream an attendee can copy in full.
pass() { workshop_print_status "$WORKSHOP_SGR_GREEN" 'PASS' 1 "$1"; }
fail() { workshop_print_status "$WORKSHOP_SGR_RED" 'FAIL' 1 "$1"; failures=$((failures + 1)); }
warn() { workshop_print_status "$WORKSHOP_SGR_YELLOW" 'WARN' 1 "$1"; warnings=$((warnings + 1)); }

check_command() {
  if command -v "$1" >/dev/null 2>&1; then
    pass "$1 is installed"
  else
    fail "$1 is not installed"
    [[ -z "${2:-}" ]] || echo "      Install: $2"
  fi
}

finish_checks() {
  local summary
  echo
  printf -v summary '%s finished with %d failure(s) and %d warning(s).' "$1" "$failures" "$warnings"
  if (( failures > 0 )); then
    workshop_print_line "$WORKSHOP_SGR_RED" 1 "$summary"
  elif (( warnings > 0 )); then
    workshop_print_line "$WORKSHOP_SGR_YELLOW" 1 "$summary"
  else
    workshop_print_line "$WORKSHOP_SGR_GREEN" 1 "$summary"
  fi
  (( failures == 0 ))
}

check_command gcloud https://cloud.google.com/sdk/docs/install
check_command node https://nodejs.org/en/download
check_command npm https://nodejs.org/en/download
if [[ "$preflight" == true ]]; then
  check_command git https://git-scm.com/downloads
  if command -v node >/dev/null 2>&1; then
    if node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 22 || (major === 22 && minor >= 6) ? 0 : 1)' >/dev/null 2>&1; then
      pass "Node.js meets the DAK setup requirement (22.6 or newer)"
    else
      fail "Node.js cannot run or is older than 22.6; install the current LTS release from https://nodejs.org/en/download"
    fi
  fi
fi

has_codex=false
has_claude=false
has_antigravity=false
if workshop_has_antigravity; then has_antigravity=true; fi
if command -v codex >/dev/null 2>&1; then
  has_codex=true
  pass "codex is installed"
fi
if command -v claude >/dev/null 2>&1; then
  has_claude=true
  pass "claude is installed"
fi
if [[ "$has_codex" == false && "$has_claude" == false && "$has_antigravity" == false ]]; then
  fail "no supported coding agent is installed (Codex, Claude Code, or Antigravity)"
  echo "      Install one supported agent using the prerequisite links in README.md."
fi

# Exit before reading project state, local overrides, or any user DAK settings.
# Only command discovery and the local Node version check run in this mode.
if [[ "$preflight" == true ]]; then
  [[ "$has_antigravity" == false ]] || pass "Antigravity is installed"
  echo
  echo "Local prerequisites only; no sign-in, project, plugin, or MCP access was checked."
  echo "Resolve any failures and rerun this check. On workshop day, run ./bin/setup PROJECT_ID --region REGION, then ./bin/doctor."
  finish_checks Preflight
  exit $?
fi

if workshop_project_id_is_valid "${GCP_PROJECT_ID:-}"; then
  pass "workshop project is configured ($GCP_PROJECT_ID)"
  workshop_export_project_env "$GCP_PROJECT_ID"
else
  unset GCP_PROJECT_ID
  fail "no valid workshop project is configured; run: ./bin/setup PROJECT_ID --region REGION"
fi

# Region state is shared by all agents and must not fall back to a default.
region_ready=false
if workshop_load_project_region; then
  region_ready=true
  pass "saved AlloyDB region: $DAK_GCP_REGION; Cloud Run region: $CLOUD_RUN_REGION (BigQuery location is separate)"
  if [[ -n "${GCP_PROJECT_ID:-}" ]] && command -v gcloud >/dev/null 2>&1; then
    if gcloud alloydb clusters describe mcp-retail-cluster --project="$GCP_PROJECT_ID" --region="$DAK_GCP_REGION" >/dev/null 2>&1; then
      pass "mcp-retail-cluster is accessible in $DAK_GCP_REGION"
    else
      fail "cannot verify the workshop cluster in the saved region; check lab readiness, IAM and the supplied --region"
    fi
  fi
else
  fail "workshop region is missing or invalid; rerun ./bin/setup PROJECT_ID --region REGION"
fi

# The Data Agent Kit version every agent on this machine should be running:
# the DAK_REF override when set, otherwise the release setup recorded.
expected_dak_ref="$(workshop_effective_dak_ref 2>/dev/null || true)"
if [[ -n "$expected_dak_ref" ]]; then
  if [[ -n "${DAK_REF:-}" ]]; then
    pass "Data Agent Kit version is pinned by config/workshop.env ($expected_dak_ref)"
  else
    pass "Data Agent Kit release recorded by setup ($expected_dak_ref)"
    # Informational only: an older release is not a fault, and the note should
    # not turn an attendee's otherwise clean report yellow.
    if latest_dak_release="$(workshop_latest_dak_release)" && [[ "$latest_dak_release" != "$expected_dak_ref" ]]; then
      echo "      Newer Data Agent Kit release available ($latest_dak_release). To move to it: ./bin/teardown, then ./bin/setup PROJECT_ID --region REGION"
    fi
  fi
else
  fail "no Data Agent Kit version is recorded; run: ./bin/setup PROJECT_ID --region REGION"
fi

if command -v gcloud >/dev/null 2>&1 && [[ -n "${GCP_PROJECT_ID:-}" ]]; then
  active_account="$(gcloud auth list --project="$GCP_PROJECT_ID" --filter=status:ACTIVE --format='value(account)' 2>/dev/null | head -n 1)"
  if [[ -n "$active_account" ]]; then
    pass "gcloud has an active account ($active_account)"
  else
    fail "gcloud has no active account; run: gcloud auth login"
  fi

  if gcloud auth application-default print-access-token --project="$GCP_PROJECT_ID" >/dev/null 2>&1; then
    pass "Application Default Credentials are available"
  else
    fail "ADC is unavailable; run: gcloud auth application-default login"
  fi
fi

check_secret_source() {
  local variable_name="$1"
  local secret_id="$2"

  if [[ -n "${!variable_name:-}" ]]; then
    pass "$variable_name is available from the environment"
    return
  fi

  if [[ -z "${GCP_PROJECT_ID:-}" ]]; then
    fail "$variable_name is unset and no workshop project is configured"
    return
  fi

  if ! command -v gcloud >/dev/null 2>&1; then
    fail "$variable_name is unset and gcloud is unavailable"
    return
  fi

  if gcloud secrets versions access "$SECRET_VERSION" \
    --secret="$secret_id" \
    --project="$GCP_PROJECT_ID" \
    >/dev/null 2>&1; then
    pass "$variable_name can be loaded from Secret Manager"
  else
    fail "Cannot access Secret Manager secret $secret_id in $GCP_PROJECT_ID"
  fi
}

check_secret_source WORKSHOP_DK_API_KEY "$DK_SECRET_ID"
check_secret_source WORKSHOP_MAPS_API_KEY "$MAPS_SECRET_ID"

# Use only the CLI's status command and its exit code. Discard both output
# streams: status can include account details or an API-key preview. Do not
# inspect credential files or start an interactive login from doctor.
check_agent_login() {
  local label="$1" login_command="$2"
  shift 2
  if "$@" </dev/null >/dev/null 2>&1; then
    pass "$label: CLI reports a configured login"
    return 0
  fi
  warn "$label: CLI login could not be confirmed; plugin/MCP checks skipped"
  echo "      Sign in with '$login_command' if needed, then rerun ./bin/doctor."
  echo "      If already signed in, check the CLI's login status and version."
  return 1
}

check_dak_version() {
  local report line
  report="$(workshop_check_dak_installation "$1" "$expected_dak_ref")"
  if [[ -z "$report" ]]; then
    fail "$1: could not verify the Data Agent Kit installation"
    return
  fi
  while IFS= read -r line; do
    case "$line" in
      PASS\ *) pass "${line#PASS }" ;;
      *) fail "${line#FAIL }; inspect the agent plugin installation, then rerun ./bin/setup PROJECT_ID --region REGION" ;;
    esac
  done <<<"$report"
}

for agent in codex claude; do
  command -v "$agent" >/dev/null 2>&1 || continue
  if [[ "$agent" == codex ]]; then
    label=Codex
    manifest=mcp.json
    check_agent_login "$label" 'codex login' codex login status || continue
    mcp_listing="$(cd "$repo_root" && codex mcp list --json 2>/dev/null)"
  else
    label='Claude Code'
    manifest=.claude-plugin/mcp.json
    check_agent_login "$label" 'claude auth login' claude auth status || continue
    mcp_listing="$(cd "$repo_root" && claude mcp list 2>/dev/null)"
  fi
  check_dak_version "$agent"
  if [[ "$region_ready" == true ]] && plugin_root="$(workshop_dak_plugin_root "$agent")" &&
     workshop_check_dak_configuration "$plugin_root" "$manifest" "$agent" &&
     workshop_dak_settings check "${GCP_PROJECT_ID:-}"; then
    pass "$label: DAK workshop services and upstream project settings are ready"
  else
    fail "$label: DAK configuration is incomplete or differs; run ./bin/setup PROJECT_ID --region REGION"
  fi
  for server in google_developer_knowledge maps_grounding_lite cloud_run; do
    if grep -Fq "$server" <<<"$mcp_listing"; then
      pass "$label: $server MCP configuration is visible"
    else
      warn "$label: $server MCP is not visible; trust the project and restart the agent"
    fi
  done
  if proxy="$(workshop_dak_proxy_path "$agent")"; then
    pass "$label: Data Agent Kit MCP proxy found ($proxy)"
  else
    fail "$label: cannot locate the Data Agent Kit MCP proxy; the Cloud Run MCP will not start"
  fi
done

# Cloud Run is the one MCP server here that answers tools/list without any
# credential at all. A server that is merely "visible" therefore proves nothing:
# an attendee with broken credentials still sees five tools listed and only
# discovers the problem when a tool call fails mid-exercise. Call a read-only
# tool for real and require a real result.
check_cloud_run_mcp() {
  local token request response verdict

  if [[ "$region_ready" != true ]]; then
    fail "Cloud Run MCP: no valid saved region; rerun ./bin/setup PROJECT_ID --region REGION"
    return
  fi

  if [[ -z "${GCP_PROJECT_ID:-}" ]]; then
    fail "Cloud Run MCP: no workshop project is configured"
    return
  fi

  for required in curl gcloud node; do
    if ! command -v "$required" >/dev/null 2>&1; then
      warn "Cloud Run MCP: cannot verify without $required"
      return
    fi
  done

  if ! token="$(gcloud auth application-default print-access-token --project="$GCP_PROJECT_ID" 2>/dev/null)" ||
    [[ -z "$token" ]]; then
    fail "Cloud Run MCP: no ADC access token; run: gcloud auth application-default login"
    return
  fi

  printf -v request \
    '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"list_services","arguments":{"project":"%s","region":"%s"}}}' \
    "$GCP_PROJECT_ID" "$CLOUD_RUN_REGION"

  # The access token is written to curl's stdin config, never passed as an
  # argument, so it cannot appear in a process listing.
  if ! response="$(
    printf 'header = "Authorization: Bearer %s"\n' "$token" |
      curl --fail --silent --max-time 30 --config - \
        --header 'Content-Type: application/json' \
        --request POST "$CLOUD_RUN_MCP_URL" \
        --data "$request" 2>/dev/null
  )"; then
    unset token
    fail "Cloud Run MCP: request failed; check connectivity and project IAM permissions"
    return
  fi
  unset token

  if [[ -z "$response" ]]; then
    fail "Cloud Run MCP: no response from $CLOUD_RUN_MCP_URL"
    return
  fi

  verdict="$(
    node -e '
      let doc = {};
      try { doc = JSON.parse(require("fs").readFileSync(0, "utf8")); } catch (error) {
        console.log("FAIL the server returned a non-JSON response");
        process.exit(0);
      }
      const result = doc && doc.result;
      if (doc && doc.error) {
        console.log("FAIL " + (doc.error.message || "the server returned an error"));
        process.exit(0);
      }
      if (!doc || doc.jsonrpc !== "2.0" || doc.id !== 1 ||
          !result || !Array.isArray(result.content)) {
        console.log("FAIL the server returned an error or an invalid tool response");
        process.exit(0);
      }
      const text = result.content
        .map((part) => (part && part.text) || "")
        .join(" ")
        .replace(/\s+/g, " ")
        .trim();
      if (result.isError) {
        console.log("FAIL " + (text || "the tool call was rejected"));
      } else if (!text && !result.structuredContent) {
        console.log("FAIL the tool returned no result content");
      } else {
        console.log("PASS list_services answered for this project");
      }
    ' <<<"$response" 2>/dev/null
  )"

  case "$verdict" in
    PASS\ *) pass "Cloud Run MCP: ${verdict#PASS }" ;;
    FAIL\ *) fail "Cloud Run MCP: ${verdict#FAIL }" ;;
    *) fail "Cloud Run MCP: could not interpret the server response" ;;
  esac
}

if [[ "$has_antigravity" == true ]]; then
  if [[ "$region_ready" == true ]] && workshop_dak_settings check "${GCP_PROJECT_ID:-}" && workshop_antigravity_config check; then
    pass "Antigravity: configuration and skills are ready"
  else
    fail "Antigravity: setup is incomplete; run ./bin/setup PROJECT_ID --region REGION"
  fi
  if [[ -n "$expected_dak_ref" ]] &&
     [[ -f "$repo_root/.workshop-state/antigravity-source/.workshop-ref" ]] &&
     [[ "$(cat "$repo_root/.workshop-state/antigravity-source/.workshop-ref")" == "$expected_dak_ref" ]]; then
    pass "Antigravity: source is at Data Agent Kit $expected_dak_ref"
  else
    fail "Antigravity: source is missing or at a different Data Agent Kit version; run ./bin/teardown, then ./bin/setup PROJECT_ID --region REGION"
  fi
  warn "Antigravity: verify sign-in and live tools inside the app; CLI has no login-status command"
fi

check_cloud_run_mcp

finish_checks Doctor
