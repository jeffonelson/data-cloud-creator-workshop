# Non-secret workshop configuration. Shell-safe KEY=VALUE assignments only.
DAK_REPOSITORY=https://github.com/GoogleCloudPlatform/data-agent-kit-plugin
# Data Agent Kit version override, normally empty. When empty, bin/setup
# resolves the newest upstream release tag once, records it in
# .workshop-state/dak-ref, and installs that same version for every agent on
# the machine. Set an immutable tag or commit SHA only to hold back a release
# that breaks the workshop; bin/doctor verifies the installed copies match.
# To move an existing install to a newer release, run ./bin/teardown and then
# ./bin/setup again.
DAK_REF=
DAK_MARKETPLACE=dak-marketplace
DAK_PLUGIN=dak@dak-marketplace

# Passed to upstream's bundled dak-setup script for every supported agent.
# BigQuery, AlloyDB and Cloud Storage are selected by bin/setup; upstream includes its
# notebook and visualization servers. The three workshop servers stay separate.
# Selected by setup --region and saved with the project.
DAK_GCP_REGION=

DK_SECRET_ID=svl-workshop-developer-knowledge-api-key
MAPS_SECRET_ID=svl-workshop-maps-grounding-api-key
SECRET_VERSION=latest

# Cloud Run MCP. Unlike Developer Knowledge and Maps Grounding Lite this server
# takes no API key: it authenticates with the attendee's Application Default
# Credentials, through the proxy the Data Agent Kit plugin already ships.
CLOUD_RUN_MCP_URL=https://run.googleapis.com/mcp
# Empty follows the selected AlloyDB region; BigQuery's location is separate.
CLOUD_RUN_REGION=

# Path of the Data Agent Kit MCP proxy inside an installed copy of the plugin.
# Both agents install the plugin under a version-scoped cache directory, so the
# directory itself is resolved at launch and only this suffix is configuration.
DAK_PROXY_RELATIVE_PATH=mcp/bin/mcp_proxy_bundle.cjs
