# Non-secret workshop configuration. Shell-safe KEY=VALUE assignments only.
DAK_REPOSITORY=https://github.com/gemini-cli-extensions/data-agent-kit-starter-pack
# Single source of truth for the upstream ref. Empty tracks the default branch.
# Set it to an immutable tag or commit SHA to pin; bin/setup propagates the
# value to both agents and bin/doctor verifies the Claude Code copy matches.
DAK_REF=
DAK_MARKETPLACE=data-agent-kit-starter-pack-marketplace
DAK_PLUGIN=dak@data-agent-kit-starter-pack-marketplace

# Data Agent Kit plugin configuration required by Claude Code's userConfig
# prompts. Non-secret. Since DAK 0.10.1 GCP_REGION is the only option the
# plugin declares; it fills the region placeholder in the Dataproc MCP URL.
DAK_GCP_REGION=us-central1

DK_SECRET_ID=svl-workshop-developer-knowledge-api-key
MAPS_SECRET_ID=svl-workshop-maps-grounding-api-key
SECRET_VERSION=latest

# Cloud Run MCP. Unlike Developer Knowledge and Maps Grounding Lite this server
# takes no API key: it authenticates with the attendee's Application Default
# Credentials, through the proxy the Data Agent Kit plugin already ships.
CLOUD_RUN_MCP_URL=https://run.googleapis.com/mcp
CLOUD_RUN_REGION=us-central1

# Path of the Data Agent Kit MCP proxy inside an installed copy of the plugin.
# Both agents install the plugin under a version-scoped cache directory, so the
# directory itself is resolved at launch and only this suffix is configuration.
DAK_PROXY_RELATIVE_PATH=mcp/bin/mcp_proxy_bundle.cjs
