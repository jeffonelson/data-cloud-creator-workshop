# Shared non-secret services used by organizer and self-service provisioning.
DK_API_SERVICE=developerknowledge.googleapis.com
MAPS_API_SERVICE=mapstools.googleapis.com
RUN_API_SERVICE=run.googleapis.com
# Cloud Run source deployments need the Compute default service account;
# enabling Compute creates it on a fresh project. Neither API needs an API key.
COMPUTE_API_SERVICE=compute.googleapis.com
